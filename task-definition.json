{
  "family": "jjt-backend",
  "taskRoleArn": "arn:aws:iam::780065485609:role/jjtBackendTaskRole",
  "executionRoleArn": "arn:aws:iam::780065485609:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "jjt-backend",
      "image": "780065485609.dkr.ecr.eu-central-1.amazonaws.com/jjt-backend:v1.0.4",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp",
          "name": "http"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "SPRING_DATASOURCE_USERNAME",
          "value": "jjt"
        },
        {
          "name": "MEDIA_STORAGE_PROVIDER",
          "value": "s3"
        },
        {
          "name": "MEDIA_S3_BUCKET",
          "value": "jjt-media-prod"
        },
        {
          "name": "SPRING_DATASOURCE_URL",
          "value": "jdbc:postgresql://jjt-postgres.c7mg4g4wesqk.eu-central-1.rds.amazonaws.com:5432/jjt"
        },
        {
          "name": "SPRING_DATASOURCE_PASSWORD",
          "value": "jjtjjt123!"
        },
        {
          "name": "MEDIA_S3_REGION",
          "value": "eu-central-1"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "jjt-backend",
          "awslogs-region": "eu-central-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "systemControls": []
    }
  ],
  "volumes": [],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  }
}
