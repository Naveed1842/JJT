meta:
  name: commit_sponsorship
  type: http

request:
  url: {{baseUrl}}/api/admin/sponsorships
  method: POST
  headers:
    X-ROLE: {{adminRole}}
  body:
    mode: raw
    raw: |
      {
        "sponsorId": "{{sponsorId}}",
        "childId": "{{childB}}",
        "startMonth": "{{nextMonth}}",
        "sponsorshipId": null
      }

tests:
  - name: created
    script: |
      expect(response.status).toBe(201);
      const body = response.json();
      expect(body.sponsorshipId).toBeDefined();
      expect(body.childId).toBe("{{childB}}");
