meta:
  name: sponsor_list_children
  type: http

request:
  url: {{baseUrl}}/api/sponsor/children
  method: GET
  headers:
    X-ROLE: {{sponsorRole}}
    X-SPONSOR-ID: {{sponsorId}}

tests:
  - name: ok
    script: |
      expect(response.status).toBe(200);
      const body = response.json();
      expect(Array.isArray(body)).toBe(true);
      expect(body.every(child => child.id === "{{childB}}")).toBe(true);
