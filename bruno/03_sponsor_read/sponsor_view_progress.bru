meta:
  name: sponsor_view_progress
  type: http

request:
  url: {{baseUrl}}/api/sponsor/children/{{childB}}/progress
  method: GET
  headers:
    X-ROLE: {{sponsorRole}}
    X-SPONSOR-ID: {{sponsorId}}

tests:
  - name: ok
    script: |
      expect(response.status).toBe(200);
      const body = response.json();
      expect(Array.isArray(body)).toBe(true);
