meta:
  name: sponsor_access_other_child_forbidden
  type: http

request:
  url: {{baseUrl}}/api/sponsor/children/{{childA}}/ledger
  method: GET
  headers:
    X-ROLE: {{sponsorRole}}
    X-SPONSOR-ID: {{sponsorId}}

tests:
  - name: forbidden
    script: |
      expect(response.status).toBe(403);
