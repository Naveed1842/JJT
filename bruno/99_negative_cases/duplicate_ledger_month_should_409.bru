meta:
  name: duplicate_ledger_month_should_409
  type: http

request:
  url: {{baseUrl}}/api/admin/early-support
  method: POST
  headers:
    X-ROLE: {{adminRole}}
  body:
    mode: raw
    raw: |
      {
        "childId": "{{childA}}",
        "month": "{{previousMonth}}",
        "educationAmount": "120.00",
        "educationCurrency": "USD"
      }

tests:
  - name: conflict
    script: |
      expect(response.status).toBe(409);
