meta:
  name: wrong_role_should_403
  type: http

request:
  url: {{baseUrl}}/api/admin/children
  method: POST
  headers:
    X-ROLE: {{sponsorRole}}
  body:
    mode: raw
    raw: |
      {
        "fullName": "Unauthorized Child",
        "educationAmount": "100.00",
        "educationCurrency": "USD"
      }

tests:
  - name: forbidden
    script: |
      expect(response.status).toBe(403);
