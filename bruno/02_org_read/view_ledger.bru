meta:
  name: org_view_ledger
  type: http

request:
  url: {{baseUrl}}/api/org/children/{{childA}}/ledger
  method: GET
  headers:
    X-ROLE: {{orgRole}}

tests:
  - name: ok
    script: |
      expect(response.status).toBe(200);
      const body = response.json();
      expect(body.childId).toBe("{{childA}}");
      expect(Array.isArray(body.entries)).toBe(true);
