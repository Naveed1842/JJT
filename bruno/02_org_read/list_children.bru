meta:
  name: org_list_children
  type: http

request:
  url: {{baseUrl}}/api/org/children
  method: GET
  headers:
    X-ROLE: {{orgRole}}

tests:
  - name: ok
    script: |
      expect(response.status).toBe(200);
      const body = response.json();
      expect(Array.isArray(body)).toBe(true);
      expect(body.length).toBeGreaterThan(0);
